# NewsToVideo 环境变量配置示例
# 复制此文件为 .env 并填入真实的配置值

# =============================================================================
# API 配置
# =============================================================================

# 谷歌GEMINI API 密钥（用于新闻获取）
GEMINI_API_KEY=your_api_key_here

# Pexels API 密钥（用于视频或者素材获取）
PEXELS_API_KEY=your_pexels_api_key_here


# =============================================================================
# 邮件通知配置
# =============================================================================

# 谷歌邮箱应用配置
GOOGLE_APP_PASSWORD=your_password_here

# =============================================================================
# 应用配置
# =============================================================================

# 定时任务 cron 表达式（默认每天17:00执行）
CRON_SCHEDULE=0 17 * * *

# 时区设置
TIMEZONE=Asia/Shanghai

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 最大重试次数
MAX_RETRY_COUNT=3

# 视频生成服务地址（用于生成口播视频）
TALK_VIDEO_SERVICE_URL=http://192.168.7.240:3000

# =============================================================================
# 平台配置
# =============================================================================

# 抖音平台配置
DOUYIN_ENABLED=true

# B站平台配置
BILIBILI_ENABLED=true

# 腾讯视频号配置
TENCENT_VIDEO_ENABLED=true

# Youtube 平台配置
YOUTUBE_ENABLED=true

# =============================================================================
# 视频配置
# =============================================================================

# 支持的视频布局 (portrait,landscape)
VIDEO_LAYOUTS=portrait

# 默认视频质量 (1080p, 720p, 480p)
DEFAULT_VIDEO_QUALITY=1080p

# 视频帧率
VIDEO_FPS=30