# NewsToVideo 环境变量配置示例
# 复制此文件为 .env 并填入真实的配置值

# =============================================================================
# API 配置
# =============================================================================

# 通义千问 API 密钥（用于新闻获取）
QWEN_API_KEY=your_qwen_api_key_here

# Pexels API 密钥（用于图片素材获取）
PEXELS_API_KEY=your_pexels_api_key_here

# 腾讯云 TTS 服务配置
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_REGION=ap-beijing

# =============================================================================
# 邮件通知配置
# =============================================================================

# SMTP 服务器配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_TO=recipient@example.com

# =============================================================================
# 应用配置
# =============================================================================

# 定时任务 cron 表达式（默认每天17:00执行）
CRON_SCHEDULE=0 17 * * *

# 时区设置
TIMEZONE=Asia/Shanghai

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 最大重试次数
MAX_RETRY_COUNT=3

# 视频生成服务地址（用于生成口播视频）
TALK_VIDEO_SERVICE_URL=http://192.168.7.240:3000

# =============================================================================
# 平台配置
# =============================================================================

# 抖音平台配置
DOUYIN_ENABLED=true

# B站平台配置
BILIBILI_ENABLED=true

# 腾讯视频号配置
TENCENT_VIDEO_ENABLED=true

# =============================================================================
# 视频配置
# =============================================================================

# 支持的视频布局 (portrait,landscape)
VIDEO_LAYOUTS=portrait

# 默认视频质量 (1080p, 720p, 480p)
DEFAULT_VIDEO_QUALITY=1080p

# 视频帧率
VIDEO_FPS=30

# 最大视频时长（秒）
MAX_VIDEO_DURATION=300